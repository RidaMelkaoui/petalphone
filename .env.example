# RevenueCat public SDK keys. Configure the real values with EAS environment variables.
# The Test Store key is for development builds only. Never use it in production.
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# Development only. Expo release builds ignore this override because __DEV__ is false.
EXPO_PUBLIC_FULL_GARDEN_DEBUG_UNLOCK=0
